# Copy to .env and adjust for your machine.

# ── LLM: Anthropic direct (recommended — same key as Claude Code) ──
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Get your key at: https://console.anthropic.com/settings/keys

# ── LLM: Cursor subscription (if you have Cursor Pro) ──
# LLM_PROVIDER=cursor
# CURSOR_BASE_URL=http://localhost:4646/v1
# CURSOR_API_KEY=not-needed
# CURSOR_MODEL=auto
# Start proxy: npx cursor-agent-api-proxy

# ── LLM: EURI alternative (euron.one Plus) ──
# LLM_PROVIDER=euri
# EURI_API_KEY=
# EURI_MODEL=gemini-2.5-flash

# ── Coral via WSL Ubuntu (Windows) ──
# After install, coral lands in /root/.local/bin — copy it to a world-accessible path:
#   wsl -d Ubuntu -u root -- cp /root/.local/bin/coral /usr/local/bin/coral
CORAL_BIN=wsl -d Ubuntu -- /usr/local/bin/coral

# Demo GitHub repo (required for github.pulls queries)
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=devsecops-coral

# Sentry demo app only (local FastAPI) — Coral uses its own token via WSL
# SENTRY_DSN=https://xxxx@o123456.ingest.us.sentry.io/789
#
# For Sentry / Jira / Grafana setup, sign up at sentry.io, atlassian.com/software/jira,
# and grafana.com, then: coral source add --interactive <source>
