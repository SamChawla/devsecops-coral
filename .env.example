# Copy to .env and adjust for your machine.

# ── LLM: Cursor subscription (recommended if you have Cursor Pro) ──
LLM_PROVIDER=cursor
CURSOR_BASE_URL=http://localhost:4646/v1
CURSOR_API_KEY=not-needed
CURSOR_MODEL=auto

# Start proxy in a separate terminal:
#   npx cursor-agent-api-proxy
# Check usage: https://cursor.com/dashboard/usage

# ── LLM: EURI alternative (euron.one Plus) ──
# LLM_PROVIDER=euri
# EURI_API_KEY=
# EURI_MODEL=gemini-2.5-flash

# ── Coral via WSL Ubuntu (Windows) ──
CORAL_BIN=wsl -d Ubuntu -e /root/.local/bin/coral

# Demo GitHub repo (required for github.pulls queries)
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=coral-signal-seed

# Sentry demo app only — never commit real DSNs
# SENTRY_DSN=
