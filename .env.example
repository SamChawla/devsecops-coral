# Copy to .env and adjust for your machine.

# --- LLM: Cursor subscription (Cursor Pro - proxy must be running) -----------
LLM_PROVIDER=cursor
CURSOR_BASE_URL=http://localhost:4646/v1
CURSOR_API_KEY=not-needed
CURSOR_MODEL=auto
# Start proxy: npx cursor-agent-api-proxy

# --- LLM: Anthropic API (separate paid account at console.anthropic.com) -----
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- LLM: EURI alternative (euron.one Plus) ----------------------------------
# LLM_PROVIDER=euri
# EURI_API_KEY=
# EURI_MODEL=gemini-2.5-flash

# --- Dashboard auth (org-scoped login) ---------------------------------------
# The dashboard ships a lightweight login + organization layer (SQLite +
# hashed passwords + httpOnly session cookies). Enabled by default.
# DEVSECOPS_AUTH_ENABLED=1            # set 0 to run the API open (CLI-only use)
# AUTH_DB_PATH=./data/auth.db         # mount this path as a volume in production
# DEVSECOPS_SESSION_TTL_HOURS=168     # session lifetime (default 7 days)
# SESSION_COOKIE_SECURE=0             # set 1 when serving over HTTPS

# --- Coral via WSL Ubuntu (Windows) ------------------------------------------
# After install, coral lands in /root/.local/bin -- copy it to a shared path:
#   wsl -d Ubuntu -u root -- cp /root/.local/bin/coral /usr/local/bin/coral
CORAL_BIN=wsl -d Ubuntu -- /usr/local/bin/coral

# --- GitHub (READ - for Coral queries + timeline) ----------------------------
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=devsecops-coral
# GITHUB_TOKEN=ghp_...

# --- Jira (WRITE - for act create_jira) --------------------------------------
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=SEC

# --- Grafana (WRITE - for act annotate_grafana) ------------------------------
# GRAFANA_URL=https://your-org.grafana.net
# GRAFANA_API_KEY=
# GRAFANA_DASHBOARD_UID=

# --- Sentry ------------------------------------------------------------------
# DSN: sentry.io → Project Settings → Client Keys → DSN
# SENTRY_DSN=https://xxxx@oXXXXXX.ingest.us.sentry.io/YYYYYYY
#
# Auth token: sentry.io → User Settings → Auth Tokens
# Scopes: project:read, event:read, org:read  (used by Coral source add sentry)
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxx
#
# Org slug: visible in sentry.io URL — sentry.io/organizations/<slug>/
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=devsecops-coral-demo
#
# SDK tuning (optional — defaults shown)
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_ENVIRONMENT=development
