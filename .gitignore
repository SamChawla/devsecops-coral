# ============================================
# devsecops-coral .gitignore
# ============================================
# CRITICAL: This file is a security guardrail.
# Do NOT remove entries without reviewing the 
# Sensitive Information Guardrails in CLAUDE.md.
# ============================================

# ── Secrets — NEVER commit ──────────────────
.env
.env.*
!.env.example
.env.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*.credential
*.secret

# ── Coral config (may contain API tokens) ───
.coral/
coral-config.yaml
coral-config.yml
*.coral.yaml

# ── Sentry ──────────────────────────────────
.sentryclirc

# ── Atlassian / Jira ────────────────────────
.atlassian/

# ── Grafana ─────────────────────────────────
grafana-config.json

# ── Anthropic ───────────────────────────────
.anthropic

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
.venv/
venv/
ENV/
env/
*.whl

# ── Testing ─────────────────────────────────
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── IDE & AI coding tools ───────────────────
.idea/
.vscode/
*.code-workspace
.cursor/
.cursorrules
.claude/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Node / Frontend ─────────────────────────
frontend/node_modules/

# ── Playwright (E2E UI tests) ───────────────
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/
test-results/
playwright-report/

# Demo app consolidated into this repo at demo/fastapi_app/
# (previously a separate GitHub repo — now deleted)
demo/fastapi_app/.git

# ── Guardrails private denylist (sensitive terms) ──
# One employer/client codename per line — read by the pre-commit scan in Guardrails.md
.guardrails-denylist.txt

# ── Project-specific local files ─────────────
# cursor.md is a duplicate of CLAUDE.md — excluded from the repo
cursor.md
# ACCOUNTS.md has real service org names (Jira URL etc.) — never commit
ACCOUNTS.md
# UI design reference — production implementation is in frontend/src/
ui-prototype.jsx
# Local submission/playbook docs — keep on disk, never in git
SHOWCASE.md
docs/TESTING.md

# ── Demo data (might contain real info) ─────
demo/data/
demo/*.sqlite3
demo/**/*.db
demo/**/output/

# ── Generated reports (ACT generate_report output) ──
reports/

# ── Logs ────────────────────────────────────
*.log
logs/

# ── Misc ────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
